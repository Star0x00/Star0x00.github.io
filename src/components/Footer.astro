---
import { langPath, ui, type Lang } from "../config";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-links">
      <a href="https://github.com/Star122013" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:hyy122013@outlook.com">Email</a>
      <a href={langPath(lang, "/rss.xml")}>RSS</a>
    </div>
    <p class="copyright">{t.footer.replace("2026", String(year))}</p>
  </div>
</footer>

<style>
.footer {
  margin-top: auto;
}
.footer-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  border-top: 1px solid var(--border);
  padding-top: 1.25rem;
  padding-bottom: 1.25rem;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}
.footer-links {
  display: flex;
  gap: 1rem;
}
.footer-links a {
  color: var(--muted-foreground);
  text-decoration: none;
  transition: color 0.2s ease;
}
.footer-links a:hover {
  color: var(--accent);
}
.copyright {
  text-align: center;
  white-space: nowrap;
}
@media (min-width: 640px) {
  .footer-inner {
    flex-direction: row-reverse;
    justify-content: space-between;
  }
}
</style>
