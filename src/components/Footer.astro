---
import { langPath, ui, type Lang } from "../config";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<footer class="footer">
  <div class="container">
    <p>{t.footer}</p>
    <div class="footer-links">
      <a href="https://github.com/Star122013" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:hyy122013@outlook.com">Email</a>
      <a href={langPath(lang, "/rss.xml")}>RSS</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: 4rem;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .footer-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .footer-links a {
    color: var(--muted-foreground);
    display: inline-flex;
    align-items: center;
    transition: color 0.15s;
  }
  .footer-links a:hover {
    color: var(--foreground);
  }
</style>