---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../PostList.astro";
import { langPath, siteMeta, ui, type Lang } from "../../config";

export interface Props {
  lang: Lang;
  posts: Array<{
    id: string;
    data: {
      title: string;
      slug: string;
      date: Date;
      description?: string;
      tags?: string[];
    };
  }>;
  page: number;
  totalPages: number;
  altUrl?: string;
}

const { lang, posts, page, totalPages, altUrl } = Astro.props;
const t = ui[lang];
const prevPage = page - 1 === 1 ? langPath(lang, "/") : langPath(lang, `/page/${page - 1}`);
const nextPage = page < totalPages ? langPath(lang, `/page/${page + 1}`) : null;
const searchIndex = langPath(lang, "/search-index.json");
---

<BaseLayout
  lang={lang}
  title={page > 1 ? (lang === "zh" ? `第 ${page} 页` : `Page ${page}`) : undefined}
  altUrl={altUrl}
>
  <div class="container home">
    <section class="hero">
      <h1>
        {siteMeta[lang].title}
        <a
          class="rss"
          href={langPath(lang, "/rss.xml")}
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
            <circle cx="5" cy="19" r="1" />
          </svg>
        </a>
      </h1>
      <p class="tagline">{t.tagline}</p>
    </section>

    <div class="search-inline">
      <input type="search" id="search-input" placeholder={t.searchPlaceholder} />
      <div id="search-results" class="search-results"></div>
    </div>

    <section class="posts">
      <h2 class="section-title">{t.recentPosts}</h2>
      <PostList posts={posts} lang={lang} />

      {totalPages > 1 && (
        <nav class="pagination">
          {page > 1 ? (
            <a href={prevPage} class="page-link">{t.previous}</a>
          ) : (
            <span class="page-link disabled">{t.previous}</span>
          )}
          <span class="page-info">{page} / {totalPages}</span>
          {nextPage ? (
            <a href={nextPage} class="page-link">{t.next}</a>
          ) : (
            <span class="page-link disabled">{t.next}</span>
          )}
        </nav>
      )}
    </section>
  </div>
</BaseLayout>

<script type="application/json" id="search-i18n" set:html={JSON.stringify({
  indexUrl: searchIndex,
  noResults: t.noResults,
})}></script>

<script data-astro-rerun>
  (async function () {
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const cfgEl = document.getElementById('search-i18n');
    if (!input || !results || !cfgEl) return;

    let cfg = { indexUrl: '/search-index.json', noResults: 'No results.' };
    try { cfg = Object.assign(cfg, JSON.parse(cfgEl.textContent)); } catch (e) {}

    const res = await fetch(cfg.indexUrl);
    const index = await res.json();

    function search(query) {
      const q = query.toLowerCase().trim();
      if (!q) { results.innerHTML = ''; return []; }
      return index.filter(function (post) {
        return (
          post.title.toLowerCase().includes(q) ||
          (post.description && post.description.toLowerCase().includes(q)) ||
          (post.tags && post.tags.some(function (t) { return t.toLowerCase().includes(q); }))
        );
      });
    }

    function render(items) {
      if (items.length === 0) {
        results.innerHTML = '<p class="empty">' + cfg.noResults + '</p>';
        return;
      }
      results.innerHTML = items.map(function (post) {
        return '<article class="result-item">' +
          '<h3><a href="' + post.url + '">' + post.title + '</a></h3>' +
          '<div class="meta">' +
            '<time>' + post.date + '</time>' +
            (post.tags && post.tags.length ? post.tags.map(function (t) { return '<span class="tag">' + t + '</span>'; }).join('') : '') +
          '</div>' +
          (post.description ? '<p>' + post.description + '</p>' : '') +
        '</article>';
      }).join('');
    }

    input.addEventListener('input', function () {
      var items = search(input.value);
      render(items);
    });
  })();
</script>

<style>
  .home {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  /* Hero：AstroPaper 的大标题 + 底部细线 */
  .hero {
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 0 1.5rem;
  }
  .hero h1 {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 1rem;
  }
  .rss {
    color: var(--accent);
    display: inline-flex;
    transition: opacity 0.2s ease;
  }
  .rss:hover {
    opacity: 0.7;
  }
  .tagline {
    color: var(--muted-foreground);
    font-size: var(--text-lg);
  }

  /* 搜索 */
  .search-inline {
    padding: 1.5rem 0 0;
  }
  #search-input {
    width: 100%;
    padding: 0.55em 0.9em;
    font-size: var(--text-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--foreground);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  #search-input::placeholder {
    color: var(--muted-foreground);
  }
  #search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--accent) 25%, transparent);
  }
  .search-results {
    margin-top: 0.75rem;
  }
  .result-item {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .result-item:last-child {
    border-bottom: none;
  }
  .result-item h3 {
    font-size: var(--text-base);
    font-weight: 500;
  }
  .result-item h3 a {
    color: var(--accent);
    text-decoration: none;
  }
  .result-item h3 a:hover {
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }
  .result-item .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.15rem;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .result-item .meta .tag {
    font-size: 0.75em;
    padding: 0.1em 0.45em;
    border-radius: 999px;
    color: var(--chip-fg);
    background: var(--chip-bg);
    border: 1px solid var(--chip-border);
  }
  .result-item p {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--foreground);
    opacity: 0.85;
  }
  .search-results .empty {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    padding: 0.5rem 0;
  }

  /* 文章列表 */
  .posts {
    padding: 2.5rem 0 3rem;
  }
  .section-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    font-size: var(--text-sm);
  }
  .page-link {
    color: var(--accent);
    text-decoration: none;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .page-link:hover {
    border-color: var(--accent);
    background: var(--chip-bg);
  }
  .page-link.disabled {
    color: var(--muted-foreground);
    opacity: 0.5;
    pointer-events: none;
  }
  .page-info {
    color: var(--muted-foreground);
  }
</style>
