---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { langPath, ui, type Lang } from "../../config";

export interface Props {
  lang: Lang;
  post: {
    data: {
      title: string;
      slug: string;
      date: Date;
      description?: string;
      tags?: string[];
      body: string;
    };
  };
  altUrl: string;
}

const { lang, post, altUrl } = Astro.props;
const { title, date, description, tags, body } = post.data;
const t = ui[lang];
const locale = lang === "zh" ? "zh-CN" : "en-US";
const copyLabel = lang === "zh" ? "复制" : "Copy";
const copiedLabel = lang === "zh" ? "已复制" : "Copied";
---

<BaseLayout lang={lang} title={title} description={description} altUrl={altUrl}>
  <article class="article">
    <aside class="toc" aria-labelledby="toc-title">
      <p class="toc-title" id="toc-title">{t.outline}</p>
      <nav class="toc-nav">
        <ul class="toc-list" id="toc-list"></ul>
      </nav>
    </aside>

    <header class="article-header">
      <h1 class="article-title">{title}</h1>
      <time class="article-date" datetime={date.toISOString()}>
        {date.toLocaleDateString(locale, {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
      {description && <p class="article-desc">{description}</p>}
      {tags && tags.length > 0 && (
        <div class="article-tags">
          {tags.map((tag) => (
            <a href={langPath(lang, `/tags/${encodeURIComponent(tag)}`)} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="article-body prose">
      <Fragment set:html={body} />
    </div>
  </article>

  <script type="application/json" id="post-i18n" set:html={JSON.stringify({
    copy: copyLabel,
    copied: copiedLabel,
  })}></script>
</BaseLayout>

<script data-astro-rerun>
(function () {
  // 跨 View Transition 导航时清掉上一篇文章的 scrollspy 监听
  if (window.__tocScroll) {
    window.removeEventListener("scroll", window.__tocScroll);
    window.__tocScroll = null;
  }

  const body = document.querySelector(".article-body");
  if (!body) return;

  var cfg = { copy: "Copy", copied: "Copied" };
  var cfgEl = document.getElementById("post-i18n");
  if (cfgEl) { try { cfg = Object.assign(cfg, JSON.parse(cfgEl.textContent)); } catch (e) {} }
  var COPY_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="14" height="14" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
  var CHECK_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
  function copyHtml(label, icon) { return label + " " + icon; }

  // ═══ 清理脚注括号 ⋯[<sup>1</sup>] → ⋯<sup>1</sup> ═══
  // Typst 把 [...] 写在 sup 外面，括号是前后文本节点
  body.querySelectorAll('sup[role="doc-noteref"]').forEach(function (ref) {
    var prev = ref.previousSibling;
    var next = ref.nextSibling;
    if (prev && prev.nodeType === 3) {
      prev.textContent = prev.textContent.replace(/\[$/, "");
    }
    if (next && next.nodeType === 3) {
      next.textContent = next.textContent.replace(/^\]/, "");
      if (next.textContent === "") next.remove();
    }
  });

  // ═══ 脚注内容 → 侧边注 ═══
  var endnotes = body.querySelector('section[role="doc-endnotes"]');
  if (endnotes) {
    var items = endnotes.querySelectorAll("li");
    if (items.length) {
      var fnMap = new Map();
      items.forEach(function (li) {
        fnMap.set(li.id, li.innerHTML);
      });

      body.querySelectorAll('sup[role="doc-noteref"]').forEach(function (ref) {
        var href = ref.querySelector("a")?.getAttribute("href");
        if (!href) return;
        var html = fnMap.get(href.slice(1));
        if (!html) return;

        var note = document.createElement("span");
        note.className = "sidenote";
        note.innerHTML = html;
        ref.after(note);
      });
    }
  }

  // ═══ Callout 框：检测 > 开头的段落 → callout 组件 ═══
  body.querySelectorAll("p").forEach(function (p) {
    var text = p.textContent || "";
    var m = text.match(/^>\s*(Tip|Warning|Important|Note|Caution)\s*[:：]?\s*/i);
    if (!m) return;

    var type = m[1].toLowerCase();
    var titles = {
      tip: "Tip",
      warning: "Warning",
      important: "Important",
      note: "Note",
      caution: "Caution",
    };
    var icons = { tip: "💡", warning: "⚠️", important: "❗", note: "📝", caution: "🔥" };

    p.innerHTML = p.innerHTML.replace(/^>\s*\w+\s*[:：]?\s*/i, "");

    var div = document.createElement("div");
    div.className = "callout";
    div.setAttribute("data-callout", type);
    div.innerHTML =
      '<div class="callout-label"><span class="callout-label-icon">' +
      icons[type] +
      "</span><span>" +
      titles[type] +
      '</span></div><div class="callout-content">' +
      p.innerHTML +
      "</div>";
    p.parentNode.replaceChild(div, p);
  });

  // ═══ 代码块：语言标签 + 复制按钮 ═══
  body.querySelectorAll("code[data-lang]").forEach(function (code) {
    var lang = code.getAttribute("data-lang") || "";

    var wrapper = document.createElement("div");
    wrapper.className = "code-block";
    code.parentNode.insertBefore(wrapper, code);
    wrapper.appendChild(code);

    var langSpan = document.createElement("span");
    langSpan.className = "code-lang";
    langSpan.textContent = lang;
    wrapper.appendChild(langSpan);

    var copyBtn = document.createElement("button");
    copyBtn.className = "code-copy";
    copyBtn.innerHTML = copyHtml(cfg.copy, COPY_ICON);
    copyBtn.setAttribute("aria-label", cfg.copy);
    copyBtn.addEventListener("click", function () {
      var text = code.textContent || "";
      navigator.clipboard.writeText(text).then(function () {
        copyBtn.innerHTML = copyHtml(cfg.copied, CHECK_ICON);
        setTimeout(function () {
          copyBtn.innerHTML = copyHtml(cfg.copy, COPY_ICON);
        }, 2000);
      });
    });
    wrapper.appendChild(copyBtn);
  });

  // ═══ 目录（Outline）：从正文标题生成，sticky 跟随滚动 ═══
  var tocList = document.getElementById("toc-list");
  var tocEl = document.querySelector(".toc");
  var headings = body.querySelectorAll("h2, h3, h4");

  if (tocList && tocEl && headings.length) {
    var usedIds = new Set();
    var tocLinks = [];

    var makeId = function (text) {
      var base = (text || "").trim().toLowerCase()
        .replace(/[^\p{L}\p{N}\s_-]/gu, "")
        .replace(/\s+/g, "-")
        .replace(/-+/g, "-")
        .replace(/^-|-$/g, "")
        .slice(0, 60);
      if (!base) base = "section";
      var id = base;
      var i = 2;
      while (usedIds.has(id)) id = base + "-" + i++;
      usedIds.add(id);
      return id;
    };

    var setActive = function (active) {
      tocLinks.forEach(function (l) {
        l.a.classList.toggle("active", l.a === active);
      });
    };

    Array.prototype.forEach.call(headings, function (h) {
      var id = h.id || makeId(h.textContent);
      h.id = id;
      var level = parseInt(h.tagName.slice(1), 10);

      var li = document.createElement("li");
      var a = document.createElement("a");
      a.className = "toc-link depth-" + level;
      a.href = "#" + id;
      a.textContent = h.textContent;
      a.addEventListener("click", function (e) {
        e.preventDefault();
        h.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", "#" + id);
        setActive(a);
      });
      li.appendChild(a);
      tocList.appendChild(li);
      tocLinks.push({ a: a, h: h });
    });

    var onScroll = function () {
      var threshold = 120;
      var current = tocLinks[0].a;
      for (var i = 0; i < tocLinks.length; i++) {
        if (tocLinks[i].h.getBoundingClientRect().top <= threshold) {
          current = tocLinks[i].a;
        } else {
          break;
        }
      }
      setActive(current);
    };

    window.__tocScroll = onScroll;
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  } else if (tocEl) {
    tocEl.remove();
  }
})();
</script>

<style>
.article {
  max-width: 95ch;
  margin: 0 auto;
  padding: 2rem 1.25rem 4rem;
}
.article-header {
  max-width: 65ch;
  margin: 0 auto 3rem;
}
.article-title {
  font-size: clamp(1.5rem, 4vw, 2.25rem);
  font-weight: 750;
  line-height: 1.2;
  margin-bottom: 0.5rem;
  letter-spacing: -0.01em;
}
.article-date {
  font-size: 0.875em;
  color: var(--muted-foreground);
  transition: color 0.3s ease;
}
.article-desc {
  margin-top: 0.75rem;
  color: var(--muted-foreground);
  font-size: var(--text-sm);
  transition: color 0.3s ease;
}
.article-tags {
  display: flex;
  gap: 0.4rem;
  margin-top: 0.75rem;
}
.article-tags .tag {
  color: var(--chip-fg);
  text-decoration: none;
  font-size: 0.8em;
  padding: 0.15em 0.55em;
  border-radius: 999px;
  background: var(--chip-bg);
  border: 1px solid var(--chip-border);
  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}
.article-tags .tag:hover {
  color: var(--accent-foreground);
  background: var(--accent);
  border-color: var(--accent);
  text-decoration: none;
}

/* Content column width — 居中，sidenote 通过负 margin 溢出到右侧 */
.article-body {
  max-width: 65ch;
  margin: 0 auto;
}

/* ===== 目录（Outline）— 桌面宽屏左侧 sticky ===== */
.toc {
  display: none;
  font-size: 0.82rem;
  line-height: 1.5;
  color: var(--muted-foreground);
}
.toc-title {
  font-size: 0.7rem;
  font-weight: 650;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--picker-head);
  margin: 0 0 0.65rem;
}
.toc-list {
  list-style: none;
  margin: 0;
  padding: 0;
  border-left: 1px solid var(--border);
}
.toc-link {
  display: block;
  padding: 0.22em 0.5em 0.22em 0.8em;
  margin-left: -1px;
  color: var(--muted-foreground);
  text-decoration: none;
  border-left: 2px solid transparent;
  transition:
    color 0.15s ease,
    border-color 0.15s ease;
}
.toc-link:hover {
  color: var(--foreground);
  text-decoration: none;
}
.toc-link.active {
  color: var(--accent);
  border-left-color: var(--accent);
}
.toc-link.depth-3 {
  padding-left: 1.6em;
  font-size: 0.95em;
}
.toc-link.depth-4 {
  padding-left: 2.4em;
  font-size: 0.9em;
}
/* 标题滚到 sticky header 下方时留出间距 */
.article-body :global(h2),
.article-body :global(h3),
.article-body :global(h4) {
  scroll-margin-top: 5.5rem;
}

/* 宽屏：三栏网格，正文居中，目录在左，sidenote 在右 */
@media (min-width: 1180px) {
  .article {
    max-width: none;
    display: grid;
    grid-template-columns: 16rem minmax(0, 65ch) 16rem;
    column-gap: 2rem;
    justify-content: center;
    align-items: start;
  }
  .article-header,
  .article-body {
    grid-column: 2;
    max-width: none;
    margin: 0;
  }
  .article-header {
    margin-bottom: 3rem;
  }
  .toc {
    display: block;
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
}

/* Sidenote: floats right, extends into the right margin via negative margin */
:global(.sidenote) {
  float: right;
  clear: right;
  width: 250px;
  margin-right: -280px;
  margin-top: 0;
  font-size: 0.82em;
  line-height: 1.5;
  color: var(--muted-foreground);
  border-left: 2px solid var(--accent);
  padding-left: 0.75em;
  opacity: 0.85;
}
:global(.sidenote sup) {
  margin-right: 0.3em;
}

/* In-text footnote markers — 无括号，accent 色 */
.article-body :global(sup[role="doc-noteref"]) {
  font-size: 0.7em;
  vertical-align: super;
  line-height: 1;
  color: var(--accent);
}
.article-body :global(sup[role="doc-noteref"] a) {
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
  transition: color 0.15s ease;
}
.article-body :global(sup[role="doc-noteref"] a:hover) {
  color: var(--foreground);
}

/* Endnotes fallback (no-JS) */
.article-body :global(section[role="doc-endnotes"]) {
  margin-top: 2em;
  padding-top: 1em;
  border-top: 1px solid var(--border);
  font-size: 0.85em;
  color: var(--muted-foreground);
}
.article-body :global(section[role="doc-endnotes"] ol) {
  padding: 0;
  margin: 0;
  list-style: none;
}
.article-body :global(section[role="doc-endnotes"] li) {
  margin-bottom: 0.5em;
}

/* 代码块：语言标签 + 复制按钮（坐落在顶边线上）
 * 颜色用 global.css 的派生色 --chip-*（同文章 tag），
 * 原来的 --muted-foreground on --muted 在亮色主题下只有 2.37~4.34:1 */
.article-body :global(.code-lang),
.article-body :global(.code-copy) {
  position: absolute;
  top: -0.7em;
  padding: 0.1em 0.5em;
  font-size: 0.82em;
  font-weight: 650;
  line-height: 1.4;
  color: var(--chip-fg);
  font-family: ui-monospace, "Cascadia Code", "SF Mono", "Fira Code", monospace;
  background: var(--chip-bg);
  border: 1px solid var(--chip-border);
  border-radius: 4px;
}
.article-body :global(.code-lang) {
  left: 0.8em;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.article-body :global(.code-copy) {
  right: 0.8em;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 0.2em;
  transition:
    color 0.15s ease,
    background 0.15s ease,
    border-color 0.15s ease;
}
.article-body :global(.code-copy:hover) {
  color: var(--accent-foreground);
  background: var(--accent);
  border-color: var(--accent);
}

/* 窄屏：sidenote 隐藏，底部端注显示 */
@media (max-width: 1000px) {
  :global(.sidenote) {
    display: none;
  }
  .article-body :global(section[role="doc-endnotes"]) {
    display: block !important;
  }
}
/* 宽屏：sidenote 显示，底部端注隐藏 */
@media (min-width: 1001px) {
  .article-body :global(section[role="doc-endnotes"]) {
    display: none;
  }
}
</style>