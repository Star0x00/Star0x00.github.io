---
import ThemePicker from "./ThemePicker.astro";
import LangPicker from "./LangPicker.astro";
import { langPath, navItems, siteMeta, ui, type Lang } from "../config";

export interface Props {
  lang: Lang;
  altUrl: string;
}

const { lang, altUrl } = Astro.props;
const t = ui[lang];

// 去掉语言前缀后做导航高亮（AstroPaper 的 active-nav）
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const bare = pathname.replace(new RegExp(`^/${lang}(?=/|$)`), "") || "/";
const isActive = (href: string) => {
  if (href === "/") return bare === "/";
  const root = bare.split("/").filter(Boolean)[0];
  return root === href.replace(/^\//, "").split("/").filter(Boolean)[0];
};
---

<header class="header">
  <div class="container header-inner">
    <a href={langPath(lang, "/")} class="logo">{siteMeta[lang].title}</a>
    <nav class="nav">
      {navItems.map((item) => (
        <a
          href={langPath(lang, item.href)}
          class:list={["nav-link", { active: isActive(item.href) }]}
        >
          {t.nav[item.key]}
        </a>
      ))}
      <LangPicker lang={lang} altUrl={altUrl} />
      <ThemePicker />
    </nav>
  </div>
</header>

<style>
.header {
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--background);
}
.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1rem;
  padding-bottom: 1rem;
}
.logo {
  font-size: 1.5em;
  font-weight: 600;
  color: var(--foreground);
  text-decoration: none;
  line-height: 1;
  white-space: nowrap;
  transition: color 0.2s ease;
}
.logo:hover {
  color: var(--accent);
}
.nav {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}
.nav-link {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--foreground);
  text-decoration: none;
  padding: 0.15rem 0;
  transition: color 0.2s ease;
}
.nav-link:hover {
  color: var(--accent);
}
/* 当前页：波浪下划线（AstroPaper 的 active-nav） */
.nav-link.active {
  text-decoration: underline;
  text-decoration-style: wavy;
  text-decoration-thickness: 2px;
  text-underline-offset: 8px;
  text-decoration-color: var(--accent);
}
@media (max-width: 640px) {
  .header-inner {
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }
  .logo {
    font-size: 1.15em;
  }
  .nav {
    gap: 0.85rem;
  }
}
</style>
