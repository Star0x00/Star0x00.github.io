---
import { langPath, ui, type Lang } from "../config";

export interface Props {
  lang: Lang;
  posts: Array<{
    id: string;
    data: {
      title: string;
      slug: string;
      date: Date;
      description?: string;
      tags?: string[];
    };
  }>;
}

const { posts, lang } = Astro.props;
const t = ui[lang];
const locale = lang === "zh" ? "zh-CN" : "en-US";
---

{posts.length > 0 ? (
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <a class="post-title" href={langPath(lang, `/blog/${post.data.slug}`)}>
          {post.data.title}
        </a>
        <div class="post-meta">
          <svg
            class="meta-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
          </svg>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString(locale, {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
          </time>
          {post.data.tags && post.data.tags.length > 0 && (
            <span class="post-tags">
              {post.data.tags.map((tag) => (
                <a href={langPath(lang, `/tags/${encodeURIComponent(tag)}`)} class="tag">{tag}</a>
              ))}
            </span>
          )}
        </div>
        {post.data.description && <p class="post-desc">{post.data.description}</p>}
      </li>
    ))}
  </ul>
) : (
  <p class="empty">{t.noPosts}</p>
)}

<style>
.post-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
/* AstroPaper 的 Card：标题 accent 色 + hover 虚线下划线，日期小字，摘要正文色 */
.post-item {
  margin: 1.5rem 0;
}
.post-title {
  display: inline-block;
  font-size: var(--text-xl);
  font-weight: 500;
  line-height: 1.35;
  color: var(--accent);
  text-decoration: none;
  text-underline-offset: 4px;
  transition: color 0.2s ease;
}
.post-title:hover {
  text-decoration: underline;
  text-decoration-style: dashed;
}
.post-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.15rem;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}
.meta-icon {
  width: 1.1em;
  height: 1.1em;
  flex-shrink: 0;
  opacity: 0.8;
}
.post-tags {
  display: inline-flex;
  gap: 0.35rem;
  margin-left: 0.25rem;
}
/* 颜色来自 global.css 的派生变量 --chip-* */
.tag {
  color: var(--chip-fg);
  text-decoration: none;
  font-size: 0.82em;
  padding: 0.1em 0.5em;
  border-radius: 999px;
  background: var(--chip-bg);
  border: 1px solid var(--chip-border);
  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}
.tag:hover {
  color: var(--accent-foreground);
  background: var(--accent);
  border-color: var(--accent);
}
.post-desc {
  margin-top: 0.35rem;
  color: var(--foreground);
  font-size: var(--text-sm);
  line-height: 1.65;
  opacity: 0.85;
}
.empty {
  text-align: center;
  color: var(--muted-foreground);
  padding: 3rem 0;
}
</style>
