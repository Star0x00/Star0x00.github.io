---
import { langPath, ui, type Lang } from "../config";

export interface Props {
  lang: Lang;
  posts: Array<{
    id: string;
    data: {
      title: string;
      slug: string;
      date: Date;
      description?: string;
      tags?: string[];
    };
  }>;
}

const { posts, lang } = Astro.props;
const t = ui[lang];
const locale = lang === "zh" ? "zh-CN" : "en-US";
---

{posts.length > 0 ? (
  posts.map((post) => (
    <article class="post-item">
      <h2>
        <a href={langPath(lang, `/blog/${post.data.slug}`)}>{post.data.title}</a>
      </h2>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString(locale, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.data.tags && post.data.tags.length > 0 && (
          <span class="post-tags">
            {post.data.tags.map((tag) => (
              <a href={langPath(lang, `/tags/${encodeURIComponent(tag)}`)} class="tag">{tag}</a>
            ))}
          </span>
        )}
      </div>
      {post.data.description && <p class="post-desc">{post.data.description}</p>}
    </article>
  ))
) : (
  <p class="empty">{t.noPosts}</p>
)}

<style>
.post-item {
  padding: 1.5rem 0;
  border-bottom: 1px solid var(--border);
  transition:
    border-color 0.3s ease,
    padding-left 0.3s ease;
}
.post-item:first-child {
  padding-top: 0;
}
.post-item:last-child {
  border-bottom: none;
}
.post-item:hover {
  padding-left: 0.75rem;
  border-bottom-color: var(--foreground);
}
.post-item:last-child:hover {
  border-bottom-color: transparent;
}
.post-item h2 {
  font-size: var(--text-xl);
  font-weight: 600;
  line-height: 1.3;
}
.post-item h2 a {
  color: var(--foreground);
  text-decoration: none;
  transition: color 0.2s ease;
}
.post-item h2 a:hover {
  color: var(--muted-foreground);
}
.post-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 0.3rem;
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}
.post-tags {
  display: flex;
  gap: 0.4rem;
}
/* 颜色来自 global.css 的派生变量 --chip-*，由当前主题的 accent 混出，
 * 保证亮色主题下也够对比度（详见 global.css 的“派生色”注释） */
.tag {
  color: var(--chip-fg);
  text-decoration: none;
  font-size: 0.8em;
  padding: 0.15em 0.55em;
  border-radius: 999px;
  background: var(--chip-bg);
  border: 1px solid var(--chip-border);
  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}
.tag:hover {
  color: var(--accent-foreground);
  background: var(--accent);
  border-color: var(--accent);
  text-decoration: none;
}
.post-desc {
  margin-top: 0.5rem;
  color: var(--muted-foreground);
  font-size: var(--text-sm);
  line-height: 1.5;
  transition: color 0.3s ease;
}
.post-item:hover .post-desc {
  color: var(--foreground);
}
.empty {
  text-align: center;
  color: var(--muted-foreground);
  padding: 3rem 0;
}
</style>