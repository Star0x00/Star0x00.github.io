---
import { languages, ui, type Lang } from "../config";

export interface Props {
  lang: Lang;
  altUrl: string;
}

const { lang, altUrl } = Astro.props;
const t = ui[lang];
const other: Lang = lang === "en" ? "zh" : "en";

// 单按钮切换：显示「当前语言」，点击切到另一种语言。
const current = {
  code: lang,
  label: lang === "en" ? "EN" : "ZH",
  name: languages[lang],
};
---

<a
  class="lang-toggle"
  href={altUrl}
  hreflang={other}
  title={current.name}
  aria-label={`${t.language}: ${current.name}`}
>
  {current.label}
</a>

<style>
.lang-toggle {
  font-size: var(--text-sm);
  font-weight: 500;
  line-height: 1;
  color: var(--foreground);
  text-decoration: none;
  transition: color 0.2s ease;
}
.lang-toggle:hover {
  color: var(--accent);
}
</style>
