---
import PostPage from "../../components/pages/PostPage.astro";
import { getAllPosts } from "../../utils/posts";
import { defaultLang, langPath } from "../../config";

const lang = defaultLang;

export async function getStaticPaths() {
  const all = await getAllPosts();
  return all
    .filter((post) => post.data.lang === defaultLang)
    .map((post) => {
      const other = all.find(
        (p) => p.data.lang === "zh" && p.data.slug === post.data.slug,
      );
      return {
        params: { slug: post.data.slug },
        props: {
          post,
          altUrl: other
            ? langPath("zh", `/blog/${other.data.slug}`)
            : langPath("zh", "/"),
        },
      };
    });
}

const { post, altUrl } = Astro.props;
---

<PostPage lang={lang} post={post} altUrl={altUrl} />